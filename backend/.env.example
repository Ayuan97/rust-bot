# ========================================
# 数据库配置
# ========================================

# MySQL 数据库连接字符串
# 格式: mysql://用户名:密码@主机:端口/数据库名
DATABASE_URL="mysql://rustplus_db:pLidmAPJepSS8mZA@47.79.78.41:3306/rustplus_db?connect_timeout=30&pool_timeout=30&ssl-mode=DISABLED"

# ========================================
# JWT 认证配置
# ========================================

# JWT 签名密钥（必须修改为随机字符串，至少 32 字符）
# 生成方法: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-secret-key-here-change-this-in-production

# JWT Token 过期时间
JWT_EXPIRES_IN=7d

# ========================================
# 服务器配置
# ========================================

# HTTP 服务器端口
PORT=3000

# 前端地址（用于 CORS 配置）
FRONTEND_URL=http://www.rustplusplus.com:5173

# 日志级别: error | warn | info | debug
LOG_LEVEL=info

# ========================================
# 支付宝支付配置
# ========================================

# 支付宝应用 ID
ALIPAY_APP_ID=your_alipay_app_id

# 支付宝应用私钥（RSA2 格式）
ALIPAY_PRIVATE_KEY=your_alipay_private_key

# 支付宝公钥（从支付宝开放平台获取）
ALIPAY_PUBLIC_KEY=alipay_public_key

# 支付宝网关地址
# 沙箱环境: https://openapi.alipaydev.com/gateway.do
# 生产环境: https://openapi.alipay.com/gateway.do
ALIPAY_GATEWAY=https://openapi.alipaydev.com/gateway.do

# 支付回调通知 URL（需要外网可访问）
ALIPAY_NOTIFY_URL=https://api.rustplusplus.com/api/payment/callback/alipay

# 支付完成跳转 URL
ALIPAY_RETURN_URL=https://api.rustplusplus.com/payment/success

# ========================================
# 代理配置（可选）
# ========================================

# 代理订阅链接（Clash/V2Ray 格式）
# 如果配置此项，项目将自动：
#   1. 下载 xray-core 二进制文件
#   2. 解析订阅链接获取节点
#   3. 启动本地代理服务
#   4. 所有外网请求（FCM、Expo、Rust+ API）自动走代理
#
# 示例: PROXY_SUBSCRIPTION_URL=https://example.com/api/v1/client/subscribe?token=xxxxx
PROXY_SUBSCRIPTION_URL=

# 指定节点名称（可选）
# 如果不指定，将自动选择第一个可用节点
# 示例: PROXY_NODE_NAME=香港节点01
PROXY_NODE_NAME=

# 代理本地端口（可选，默认 10808）
PROXY_PORT=10808

# ========================================
# 管理员账户（首次部署）
# ========================================

# 默认管理员密码（首次运行 seed-admin.js 时使用）
# 生产环境请务必修改！
ADMIN_DEFAULT_PASSWORD=admin123456


# ========================================
# Steam API 配置
# ========================================
STEAM_API_KEY=your_steam_api_key

# ========================================
# Battlemetrics API 配置
# ========================================
# 从 https://www.battlemetrics.com/developers 获取 Personal Access Token
# 认证后速率限制: 300 请求/分钟 (未认证仅 60/分钟)
BATTLEMETRICS_API_TOKEN=your_battlemetrics_token
