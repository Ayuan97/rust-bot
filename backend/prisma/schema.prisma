generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model devices {
  id          String           @id
  serverId    String
  entityId    Int
  name        String           @db.VarChar(100)
  type        devices_type
  command     String?          @db.VarChar(50)
  autoMode    devices_autoMode @default(NONE)
  isActive    Boolean          @default(true)
  reachable   Boolean          @default(true)
  lastTrigger DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  servers     servers          @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, entityId])
  @@index([serverId])
}

model event_logs {
  id        String               @id
  serverId  String
  eventType event_logs_eventType
  eventData Json
  createdAt DateTime             @default(now())
  servers   servers              @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([eventType])
  @@index([serverId])
}

model notification_settings {
  id        String   @id
  userId    String   @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model orders {
  id            String               @id
  userId        String
  planType      orders_planType
  amount        Decimal              @db.Decimal(10, 2)
  paymentMethod orders_paymentMethod
  status        orders_status        @default(PENDING)
  tradeNo       String?              @db.VarChar(100)
  qrCode        String?              @db.Text
  expireAt      DateTime?
  paidAt        DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime
  users         users                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([status])
  @@index([tradeNo])
  @@index([userId])
}

model proxy_config {
  id              Int      @id @default(1)
  subscriptionUrl String?  @db.Text
  selectedNode    String?  @db.VarChar(255)
  proxyPort       Int      @default(10808)
  autoStart       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model servers {
  id              String       @id
  userId          String
  name            String       @db.VarChar(100)
  ip              String       @db.VarChar(45)
  port            String       @db.VarChar(10)
  playerId        String       @db.VarChar(50)
  playerToken     String       @db.VarChar(50)
  battlemetricsId String?      @db.VarChar(50)
  img             String?      @db.Text
  logo            String?      @db.Text
  url             String?      @db.VarChar(255)
  description     String?      @db.Text
  fcmCredentials  Json?
  isActive        Boolean      @default(true)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime
  devices         devices[]
  event_logs      event_logs[]
  users           users        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ip, port])
  @@index([playerId])
  @@index([userId])
}

model subscriptions {
  id            String                       @id
  userId        String                       @unique
  planType      subscriptions_planType       @default(TRIAL)
  startDate     DateTime                     @default(now())
  endDate       DateTime
  amount        Decimal?                     @db.Decimal(10, 2)
  paymentMethod subscriptions_paymentMethod?
  transactionId String?                      @db.VarChar(100)
  autoRenew     Boolean                      @default(false)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime
  users         users                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([endDate])
  @@index([userId])
}

model users {
  id                    String                 @id
  username              String                 @unique @db.VarChar(50)
  email                 String                 @unique @db.VarChar(100)
  password              String                 @db.VarChar(255)
  isActive              Boolean                @default(true)
  isAdmin               Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  lastLogin             DateTime?
  notification_settings notification_settings?
  orders                orders[]
  servers               servers[]
  subscriptions         subscriptions?

  @@index([email])
  @@index([username])
}

enum orders_planType {
  TRIAL
  MONTHLY
  QUARTERLY
  YEARLY
}

enum subscriptions_planType {
  TRIAL
  MONTHLY
  QUARTERLY
  YEARLY
}

enum event_logs_eventType {
  PLAYER_DEATH
  PLAYER_ONLINE
  PLAYER_OFFLINE
  PLAYER_AFK
  PLAYER_RETURN
  CARGO_SPAWN
  CARGO_LEAVE
  HELI_SPAWN
  HELI_DOWN
  OIL_RIG_TRIGGERED
  OIL_RIG_UNLOCKED
  CHINOOK_SPAWN
  ALARM_TRIGGERED
  DEVICE_OFFLINE
  SERVER_CONNECTED
  SERVER_DISCONNECTED
  FCM_CONNECTED
  FCM_DISCONNECTED
}

enum orders_paymentMethod {
  ALIPAY
  WECHAT
}

enum devices_type {
  SWITCH
  ALARM
  STORAGE
}

enum orders_status {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum devices_autoMode {
  NONE
  DAY_ON
  NIGHT_ON
  ALWAYS_ON
  ALWAYS_OFF
  ONLINE_ON
  ONLINE_OFF
}

enum subscriptions_paymentMethod {
  ALIPAY
  WECHAT
}
