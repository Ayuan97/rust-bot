// Prisma Schema for Rust+ Multi-tenant Dashboard
// 数据库提供者: MySQL 8.0
// ORM: Prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

// ============================================================
// 用户与订阅模块
// ============================================================

/// 用户表
model User {
  id        String   @id @default(uuid())
  username  String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255) // bcrypt hash

  // 用户状态
  isActive  Boolean  @default(true)
  isAdmin   Boolean  @default(false)

  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastLogin DateTime?

  // 关系
  subscription          Subscription?
  servers               Server[]
  notificationSettings  NotificationSettings?

  @@index([email])
  @@index([username])
  @@map("users")
}

/// 订阅表
model Subscription {
  id      String @id @default(uuid())
  userId  String @unique

  // 订阅计划类型
  planType     SubscriptionPlan @default(TRIAL)

  // 订阅时间
  startDate    DateTime         @default(now())
  endDate      DateTime         // 服务到期时间

  // 支付信息
  amount       Decimal?         @db.Decimal(10, 2)
  paymentMethod PaymentMethod?
  transactionId String?         @db.VarChar(100)

  // 自动续费
  autoRenew    Boolean          @default(false)

  // 时间戳
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // 关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([endDate])
  @@map("subscriptions")
}

/// 订阅计划枚举
enum SubscriptionPlan {
  TRIAL    // 试用：7天免费
  MONTHLY  // 月付：¥29/月
  QUARTERLY // 季付：¥79/季
  YEARLY   // 年付：¥299/年
}

/// 支付方式枚举
enum PaymentMethod {
  ALIPAY  // 支付宝
  WECHAT  // 微信支付
}

// ============================================================
// 游戏服务器与设备模块
// ============================================================

/// 服务器表
model Server {
  id        String   @id @default(uuid())
  userId    String   // 外键 → User

  // 服务器基本信息
  name        String   @db.VarChar(100)
  ip          String   @db.VarChar(45) // 支持 IPv6
  port        String   @db.VarChar(10)

  // Rust+ 认证信息
  playerId    String   @db.VarChar(50)
  playerToken String   @db.VarChar(50)

  // 服务器扩展信息
  battlemetricsId String?  @db.VarChar(50)
  img             String?  @db.Text
  logo            String?  @db.Text
  url             String?  @db.VarChar(255)
  description     String?  @db.Text

  // FCM 推送凭证（每个服务器独立）
  fcmCredentials Json?    // GCM 格式: {gcm: {androidId, securityToken}, steam: {steamId}}

  // 服务器状态
  isActive    Boolean  @default(true)

  // 时间戳
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // 关系
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  devices    Device[]
  eventLogs  EventLog[]

  @@unique([userId, ip, port]) // 同一用户不能添加重复的服务器
  @@index([userId])
  @@index([playerId])
  @@map("servers")
}

/// 设备表
model Device {
  id       String @id @default(uuid())
  serverId String // 外键 → Server

  // 设备基本信息
  entityId Int    // Rust+ 设备实体 ID
  name     String @db.VarChar(100)
  type     DeviceType

  // 自定义命令
  command  String? @db.VarChar(50) // 游戏内命令名（如 "灯"）

  // 自动化模式
  autoMode AutoMode @default(NONE)

  // 设备状态
  isActive   Boolean  @default(true)
  reachable  Boolean  @default(true) // 设备是否可达

  // 警报触发时间（仅 ALARM 类型）
  lastTrigger DateTime?

  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([serverId, entityId]) // 同一服务器不能有重复的设备实体 ID
  @@index([serverId])
  @@map("devices")
}

/// 设备类型枚举
enum DeviceType {
  SWITCH  // 智能开关
  ALARM   // 智能警报
  STORAGE // 存储监视器
}

/// 自动化模式枚举
enum AutoMode {
  NONE        // 0: 无自动化
  DAY_ON      // 1: 白天开启
  NIGHT_ON    // 2: 夜晚开启
  ALWAYS_ON   // 3: 始终开启
  ALWAYS_OFF  // 4: 始终关闭
  ONLINE_ON   // 7: 有人在线时开启
  ONLINE_OFF  // 8: 有人在线时关闭
}

// ============================================================
// 事件日志与通知模块
// ============================================================

/// 事件日志表
model EventLog {
  id        String   @id @default(uuid())
  serverId  String   // 外键 → Server

  // 事件信息
  eventType EventType
  eventData Json     // 事件详细数据（JSON 格式）

  // 时间戳
  createdAt DateTime @default(now())

  // 关系
  server Server @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@index([serverId])
  @@index([eventType])
  @@index([createdAt])
  @@map("event_logs")
}

/// 事件类型枚举
enum EventType {
  // 玩家事件
  PLAYER_DEATH
  PLAYER_ONLINE
  PLAYER_OFFLINE
  PLAYER_AFK
  PLAYER_RETURN

  // 游戏事件
  CARGO_SPAWN
  CARGO_LEAVE
  HELI_SPAWN
  HELI_DOWN
  OIL_RIG_TRIGGERED
  OIL_RIG_UNLOCKED
  CHINOOK_SPAWN

  // 设备事件
  ALARM_TRIGGERED
  DEVICE_OFFLINE

  // 系统事件
  SERVER_CONNECTED
  SERVER_DISCONNECTED
  FCM_CONNECTED
  FCM_DISCONNECTED
}

/// 通知设置表（每个用户一条记录）
model NotificationSettings {
  id     String @id @default(uuid())
  userId String @unique

  // 通知开关配置（JSON 格式）
  // 格式: { "player_death": true, "cargo_spawn": false, ... }
  settings Json   @default("{}")

  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 关系
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_settings")
}

// ============================================================
// 系统配置模块
// ============================================================

/// 代理配置表（全局单例）
model ProxyConfig {
  id Int @id @default(1) // 强制单例

  // 代理订阅
  subscriptionUrl String? @db.Text
  selectedNode    String? @db.VarChar(255)

  // 代理端口
  proxyPort Int @default(10808)

  // 自动启动
  autoStart Boolean @default(false)

  // 时间戳
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("proxy_config")
}
