generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model devices {
  id          String           @id
  serverId    String
  userId      String           // 多租户：用户ID（冗余字段便于查询）
  entityId    Int
  name        String           @db.VarChar(100)
  type        devices_type
  command     String?          @db.VarChar(50)
  message     String?          @db.VarChar(255)
  autoMode    devices_autoMode @default(NONE)
  isActive    Boolean          @default(true)
  reachable   Boolean          @default(true)
  lastTrigger DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime
  servers     servers          @relation(fields: [serverId], references: [id], onDelete: Cascade)
  users       users            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([serverId, entityId])
  @@index([serverId])
  @@index([userId])
}

model event_logs {
  id        String               @id
  serverId  String
  userId    String               // 多租户：用户ID（冗余字段便于查询）
  eventType event_logs_eventType
  eventData Json
  createdAt DateTime             @default(now())
  servers   servers              @relation(fields: [serverId], references: [id], onDelete: Cascade)
  users     users                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([createdAt])
  @@index([eventType])
  @@index([serverId])
  @@index([userId])
}

model notification_settings {
  id        String   @id
  userId    String   @unique
  settings  Json
  createdAt DateTime @default(now())
  updatedAt DateTime
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model orders {
  id            String               @id
  userId        String
  type          orders_type          @default(AUTH_BUY)
  planType      orders_planType?     // 旧字段，保持兼容
  planId        String?              // 新字段，关联套餐配置
  amount        Decimal              @db.Decimal(10, 2)
  balanceBefore Decimal?             @db.Decimal(10, 2)
  balanceAfter  Decimal?             @db.Decimal(10, 2)
  paymentMethod orders_paymentMethod?
  status        orders_status        @default(PENDING)
  tradeNo       String?              @db.VarChar(100)
  qrCode        String?              @db.Text
  expireAt      DateTime?
  paidAt        DateTime?
  notes         String?              @db.Text
  createdAt     DateTime             @default(now())
  updatedAt     DateTime
  users         users                @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          subscription_plans?  @relation(fields: [planId], references: [id])

  @@index([createdAt])
  @@index([status])
  @@index([tradeNo])
  @@index([userId])
  @@index([planId])
}

model admin_logs {
  id           String   @id
  adminId      String
  targetUserId String
  action       String   @db.VarChar(50)
  details      Json
  createdAt    DateTime @default(now())

  @@index([adminId])
  @@index([targetUserId])
  @@index([createdAt])
}

model proxy_config {
  id              Int      @id @default(1)
  subscriptionUrl String?  @db.Text
  selectedNode    String?  @db.VarChar(255)
  proxyPort       Int      @default(10808)
  autoStart       Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime
}

model servers {
  id                 String               @id
  userId             String
  name               String               @db.VarChar(100)
  ip                 String               @db.VarChar(45)
  port               String               @db.VarChar(10)
  playerId           String               @db.VarChar(50)
  playerToken        String               @db.VarChar(50)
  battlemetricsId    String?              @db.VarChar(50)
  img                String?              @db.Text
  logo               String?              @db.Text
  url                String?              @db.VarChar(255)
  description        String?              @db.Text
  fcmCredentials     Json?
  isActive           Boolean              @default(true)
  createdAt          DateTime             @default(now())
  updatedAt          DateTime
  devices            devices[]
  event_logs         event_logs[]
  extended_teammates extended_teammates[]
  users              users                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, ip, port])
  @@index([playerId])
  @@index([userId])
}

model subscriptions {
  id            String                       @id
  userId        String                       @unique
  planType      subscriptions_planType       @default(TRIAL)
  status        subscriptions_status         @default(ACTIVE)
  startDate     DateTime                     @default(now())
  endDate       DateTime
  amount        Decimal?                     @db.Decimal(10, 2)
  paymentMethod subscriptions_paymentMethod?
  transactionId String?                      @db.VarChar(100)
  autoRenew     Boolean                      @default(false)
  createdAt     DateTime                     @default(now())
  updatedAt     DateTime
  users         users                        @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([endDate])
  @@index([userId])
  @@index([status])
}

model users {
  id                    String                 @id
  username              String                 @unique @db.VarChar(50)
  email                 String?                @unique @db.VarChar(100)
  password              String                 @db.VarChar(255)
  balance               Decimal                @default(0.00) @db.Decimal(10, 2)
  isActive              Boolean                @default(true)
  isAdmin               Boolean                @default(false)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime
  lastLogin             DateTime?
  notification_settings notification_settings?
  orders                orders[]
  servers               servers[]
  subscriptions         subscriptions?
  devices               devices[]
  event_logs            event_logs[]
  extended_teammates    extended_teammates[]

  @@index([email])
  @@index([username])
}

model player_profiles {
  steamId     String   @id
  name        String?
  avatar      String?
  playtime    Int      @default(0)
  vacBanned   Boolean  @default(false)
  gameBans    Int      @default(0)
  lastUpdated DateTime @default(now())
}

model player_stats {
  id        String   @id @default(uuid())
  steamId   String
  statKey   String
  statValue Float
  updatedAt DateTime @default(now())

  @@unique([steamId, statKey])
}

model player_stats_snapshots {
  id           String   @id @default(uuid())
  steamId      String
  statKey      String
  statValue    Float
  snapshotDate DateTime @default(now())

  @@unique([steamId, statKey, snapshotDate])
}

model extended_teammates {
  id         String    @id @default(uuid())
  userId     String
  serverId   String
  steamId    String
  addedAt    DateTime  @default(now())
  lastSeenAt DateTime?
  notes      String?   @db.VarChar(255)

  users   users   @relation(fields: [userId], references: [id], onDelete: Cascade)
  servers servers @relation(fields: [serverId], references: [id], onDelete: Cascade)

  @@unique([userId, serverId, steamId])
  @@index([userId])
  @@index([serverId])
  @@index([steamId])
}

enum orders_type {
  TOPUP
  AUTH_BUY
  SERVICE_FEE
  ADMIN_ADJUST
}

enum orders_planType {
  TRIAL
  MONTHLY
  QUARTERLY
  YEARLY
}

enum subscriptions_planType {
  TRIAL
  MONTHLY
  QUARTERLY
  YEARLY
}

enum event_logs_eventType {
  PLAYER_DEATH
  PLAYER_ONLINE
  PLAYER_OFFLINE
  PLAYER_AFK
  PLAYER_RETURN
  CARGO_SPAWN
  CARGO_LEAVE
  HELI_SPAWN
  HELI_DOWN
  OIL_RIG_TRIGGERED
  OIL_RIG_UNLOCKED
  CHINOOK_SPAWN
  ALARM_TRIGGERED
  ENTITY_CHANGED
  DEVICE_OFFLINE
  SERVER_CONNECTED
  SERVER_DISCONNECTED
  FCM_CONNECTED
  FCM_DISCONNECTED
}

enum orders_paymentMethod {
  ALIPAY
  WECHAT
}

enum devices_type {
  SWITCH
  ALARM
  STORAGE
}

enum orders_status {
  PENDING
  PAID
  FAILED
  CANCELLED
  EXPIRED
}

enum devices_autoMode {
  NONE
  DAY_ON
  NIGHT_ON
  ALWAYS_ON
  ALWAYS_OFF
  ONLINE_ON
  ONLINE_OFF
}

enum subscriptions_paymentMethod {
  ALIPAY
  WECHAT
}

enum subscriptions_status {
  ACTIVE
  EXPIRED
  CANCELLED
}

// ============================================================
// 公共服务器信息 (Battlemetrics 数据缓存)
// ============================================================
model public_servers {
  // 主键
  battlemetricsId    String    @id @db.VarChar(50)

  // 基础信息
  name               String    @db.VarChar(255)
  ip                 String?   @db.VarChar(45)
  port               Int?                          // 游戏端口
  address            String?   @db.VarChar(100)    // ip:port 组合
  status             String    @default("online") @db.VarChar(20)

  // 玩家信息
  players            Int       @default(0)
  maxPlayers         Int       @default(0)
  queuedPlayers      Int       @default(0)

  // 排名与性能
  rank               Int?
  fps                Int?
  fpsAvg             Int?
  uptime             Int?                          // 服务器运行时间(秒)
  entityCount        Int?                          // 实体数量

  // 地图信息
  map                String?   @db.VarChar(100)
  mapSize            Int?
  seed               Int?

  // 清档信息
  wipeTime           DateTime?                     // 上次清档时间
  wipeCycle          String?   @db.VarChar(20)     // WEEKLY/BIWEEKLY/MONTHLY
  nextWipe           DateTime?                     // 预估下次清档

  // 媒体资源
  headerImage        String?   @db.Text
  logoImage          String?   @db.Text
  rustMapsUrl        String?   @db.VarChar(255)
  rustMapsThumbnail  String?   @db.Text

  // 服务器属性
  country            String?   @db.VarChar(50)
  official           Boolean   @default(false)
  modded             Boolean   @default(false)
  pve                Boolean   @default(false)
  description        String?   @db.Text
  url                String?   @db.VarChar(255)

  // 时间戳
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([name])
  @@index([updatedAt])
}

model subscription_plans {
  id          String   @id @default(uuid())
  code        String   @unique @db.VarChar(50)  // 套餐代码: WEEKLY, BIWEEKLY, MONTHLY 等
  name        String   @db.VarChar(100)         // 显示名称: 周卡, 半月卡, 月卡
  price       Decimal  @db.Decimal(10, 2)       // 价格
  duration    Int                                // 时长(天)
  description String?  @db.VarChar(255)         // 描述
  features    Json?                              // 功能特性列表 JSON
  sortOrder   Int      @default(0)              // 排序顺序
  isActive    Boolean  @default(true)           // 是否启用
  highlighted Boolean  @default(false)          // 是否推荐(高亮显示)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  orders      orders[]

  @@index([isActive, sortOrder])
}
