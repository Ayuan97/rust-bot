# ==================== 应用配置 ====================
NODE_ENV=production
BACKEND_PORT=3000
FRONTEND_PORT=5173
FRONTEND_URL=http://localhost:5173
LOG_LEVEL=info

# ==================== 数据库配置 ====================
MYSQL_ROOT_PASSWORD=your_secure_root_password
MYSQL_DATABASE=rustplus_db
MYSQL_USER=rustplus
MYSQL_PASSWORD=your_secure_password
MYSQL_PORT=3306

# ==================== Redis 配置 ====================
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== JWT 配置 ====================
JWT_SECRET=your_jwt_secret_change_in_production_must_be_very_long_and_random
JWT_EXPIRES_IN=7d

# ==================== 代理配置 ====================
PROXY_SOCKS_PORT=10808
PROXY_HTTP_PORT=10809

# ==================== 支付宝配置 ====================
ALIPAY_APP_ID=
ALIPAY_PRIVATE_KEY=
ALIPAY_PUBLIC_KEY=

# ==================== 微信支付配置 ====================
WECHAT_APP_ID=
WECHAT_MCH_ID=
WECHAT_API_KEY=

# ==================== 邮件配置（可选）====================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# ==================== 前端构建参数 ====================
VITE_API_URL=/api
VITE_SOCKET_URL=
