# =========================
# 基础运行配置
# =========================
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173
# 生产环境建议开启，保证限流按真实客户端 IP 生效（反向代理场景）
TRUST_PROXY=true

# =========================
# MySQL
# =========================
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=replace_me
DB_NAME=rustplus_db
# 连接池上限（主节点所有 DB 流量共享；高并发/多子节点时可调大）
DB_POOL_LIMIT=30

# =========================
# 鉴权
# =========================
JWT_SECRET=replace_with_random_string_at_least_32_chars
# 子节点内部认证：主节点用此 secret 签发/验签每个子节点的 JWT（务必随机、保密、至少 32 位）
NODE_TOKEN_SECRET=replace_with_random_secret_at_least_32_chars
# /api/internal 允许的来源 IP（默认仅本机；跨机子节点把其出口 IP 加进来，逗号分隔；设为 * 关闭限制）
INTERNAL_ALLOWED_IPS=127.0.0.1,::1

# =========================
# 前端（Vite 会从根目录读取）
# =========================
VITE_API_URL=http://127.0.0.1:3000/api
VITE_SOCKET_URL=http://127.0.0.1:3000

# =========================
# 分布式连接
# =========================
RUST_CONN_MODE=distributed
USER_MONTHLY_PRICE=20
INFRA_COST_RATIO_CAP=0.35

DISTRIBUTED_NODE_CAPACITY=120
DISTRIBUTED_MAX_PER_SERVER=4
DISTRIBUTED_GATEWAY_HEARTBEAT_TTL_SEC=30
DISTRIBUTED_FAILOVER_GRACE_SEC=20
DISTRIBUTED_FAILOVER_BATCH_SIZE=200
DISTRIBUTED_QUEUE_EXPIRE_MINUTES=10
DISTRIBUTED_COMMAND_TIMEOUT_MS=25000
# 命令结果兜底轮询间隔（正常由事件唤醒，此为 failover/close 等边缘路径兜底）
DISTRIBUTED_COMMAND_FALLBACK_POLL_MS=2000
# CLAIMED 命令多久无结果视为认领超时、允许被重新认领（应 < COMMAND_TIMEOUT_MS）
DISTRIBUTED_COMMAND_CLAIM_TIMEOUT_MS=15000
DISTRIBUTED_BACKGROUND_INTERVAL_MS=10000
DISTRIBUTED_EXPIRE_CLEANUP_BATCH_SIZE=300
DISTRIBUTED_EXPIRE_CLEANUP_MAX_BATCHES=8
DISTRIBUTED_COMMAND_REUSE_WINDOW_MS=1500

# Connector 节点配置（仅子节点机器需要）
# NODE_TOKEN：用 `node backend/scripts/issue-node-token.js <nodeId>` 签发，令牌中的 nodeId 即该节点身份
# NODE_TOKEN=
# CONTROL_API_URL=http://127.0.0.1:3000/api/internal
# NODE_PUBLIC_IP=127.0.0.1
# NODE_REGION=local
# NODE_CAPACITY=120
# NODE_MAX_PER_SERVER=4
# NODE_CONTROL_PLANE_STALE_MS=45000
# NODE_CONTROL_PLANE_CHECK_INTERVAL_MS=2000

# =========================
# 自动扩缩容（可选）
# =========================
AUTOSCALER_ENABLED=false
AUTOSCALER_INTERVAL_MS=30000
AUTOSCALER_COOLDOWN_MS=120000
AUTOSCALER_MIN_NODES=0
AUTOSCALER_HOTTEST_THRESHOLD=0.75
AUTOSCALER_GLOBAL_THRESHOLD=0.70
AUTOSCALER_DOWN_THRESHOLD=0.35
AUTOSCALER_HOTTEST_HOLD_MS=30000
AUTOSCALER_GLOBAL_HOLD_MS=120000
AUTOSCALER_PENDING_HOLD_MS=30000
AUTOSCALER_IDLE_HOLD_MS=900000
# 阈值短暂回落的宽限期，避免抖动把持续越阈的计时清零
AUTOSCALER_HOLD_RELEASE_GRACE_MS=5000
AUTOSCALER_NODE_MONTHLY_COST=120

# 二选一配置扩容执行方式（可选）
# AUTOSCALER_WEBHOOK_URL=
# AUTOSCALER_WEBHOOK_TOKEN=
# AUTOSCALER_SCALE_UP_COMMAND=
# AUTOSCALER_SCALE_DOWN_COMMAND=
