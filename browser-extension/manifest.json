{
    "manifest_version": 3,
    "name": "Rust+ Credentials Helper",
    "version": "1.0.0",
    "description": "获取 Rust+ FCM 凭证，用于 Rust+ Web Dashboard",
    "icons": {
        "128": "icons/icon128.png"
    },
    "permissions": [
        "storage",
        "activeTab",
        "scripting"
    ],
    "host_permissions": [
        "https://companion-rust.facepunch.com/*",
        "https://exp.host/*"
    ],
    "action": {
        "default_popup": "popup.html",
        "default_icon": {
            "128": "icons/icon128.png"
        },
        "default_title": "Rust+ Credentials Helper"
    },
    "background": {
        "service_worker": "background.js"
    },
    "content_scripts": [
        {
            "matches": [
                "https://companion-rust.facepunch.com/*"
            ],
            "js": [
                "content.js"
            ],
            "run_at": "document_start",
            "all_frames": true
        }
    ],
    "web_accessible_resources": [
        {
            "resources": [
                "inject.js"
            ],
            "matches": [
                "https://companion-rust.facepunch.com/*"
            ]
        }
    ]
}